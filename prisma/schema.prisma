generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("NEXT_PUBLIC_SUPABASE_URL_DB") // On utilisera une string de connexion postgres directe pour Prisma
  directUrl = env("SUPABASE_DIRECT_URL") // Nécessaire pour Supabase avec Prisma
}

enum Role {
  ADMIN
  CUSTOMER
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductType {
  SIMPLE
  VARIABLE
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  BANK_TRANSFER
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  products Product[]
}

model Product {
  id             String      @id @default(uuid()) @db.Uuid
  title          String
  slug           String      @unique @default("temp-slug")
  type           ProductType @default(SIMPLE)
  shortDescription String?   @db.Text
  description    String?     @db.Text
  price          Float       // Global/Base price (lowest variation price or simple price)
  compareAtPrice Float?
  images         String[]
  categoryId     String      @db.Uuid
  category       Category    @relation(fields: [categoryId], references: [id])
  stock          Int?        // Null = En stock (illimité), used for simple product
  attributes     Json?       // e.g. [{"name": "Couleur", "options": ["Rouge", "Bleu"]}]
  variations     Json?       // e.g. [{"id": "uuid", "attributes": {"Couleur": "Rouge"}, "price": 10, "stock": 5}]
  isBestSeller   Boolean     @default(false)
  isDealOfTheDay Boolean     @default(false)
  discountLabel  String?
  tags           String[]    @default([])
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  user           User        @relation(fields: [userId], references: [id])
  status         OrderStatus @default(PENDING)
  paymentMethod  PaymentMethod @default(STRIPE)
  total          Float
  stripeSessionId String?
  orderItems     OrderItem[]
  
  // Tracking Fields
  trackingNumber String?     @unique
  originCity     String?
  originCountry  String?
  originLat      Float?
  originLng      Float?
  destinationAddress String?
  destinationCountry String?
  destinationLat Float?
  destinationLng Float?
  
  deliveryPositions DeliveryPosition[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Coupon {
  id                 String     @id @default(uuid()) @db.Uuid
  code               String     @unique
  type               CouponType @default(PERCENTAGE)
  value              Float
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

enum ChatSessionStatus {
  OPEN
  CLOSED
}

enum ChatSender {
  CUSTOMER
  ADMIN
}

model ChatSession {
  id        String            @id @default(uuid()) @db.Uuid
  guestId   String            // Can be a session/localstorage UUID for unauthenticated users
  status    ChatSessionStatus @default(OPEN)
  messages  ChatMessage[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ChatMessage {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    ChatSender
  content   String      @db.Text
  createdAt DateTime    @default(now())
}

model ShippingZone {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  methods   ShippingMethod[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingMethod {
  id               String       @id @default(uuid()) @db.Uuid
  zoneId           String       @db.Uuid
  zone             ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  type             String       // "Livraison Gratuite", "Standard", "Expresse", "Collecte au magasin"
  rate             Float        @default(0.0)
  minOrderAmount   Float?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model DeliveryPosition {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  city      String
  country   String
  latitude  Float
  longitude Float
  note      String?  @db.Text
  createdAt DateTime @default(now())
}
